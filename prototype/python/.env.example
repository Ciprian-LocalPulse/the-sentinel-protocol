# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file — it is listed in .gitignore.

# Generated once via IronVault.generate_key() — see docs/deployment/local.md
SENTINEL_MASTER_KEY=

# LLM provider key, used by prompts/ for scoring/drafting calls
LLM_API_KEY=

# Optional — Energy Shield wearable integration (docs/energy/biometrics.md)
WEARABLE_API_KEY=
WEARABLE_PROVIDER=oura

# Optional — channel integrations (docs/examples/)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
SLACK_BOT_TOKEN=
CALENDAR_CLIENT_ID=
